{
  "name": "vnstat-visualizer-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3030",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --pretty false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.6.0",
    "pinia": "^3.0.0",
    "vuetify": "^3.8.0",
    "@mdi/font": "^7.4.0",
    "axios": "^1.7.0",
    "apexcharts": "^5.10.0",
    "vue3-apexcharts": "^1.8.0"
  },
  "devDependencies": {
    "typescript": "~5.7.0",
    "vite": "^6.3.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/tsconfig": "^0.7.0",
    "vue-tsc": "^2.2.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "vue-eslint-parser": "^10.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "vitest": "^3.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^25.0.0",
    "@types/node": "^22.0.0"
  }
}
